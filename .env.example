PORT=4000

# Local Postgres from docker-compose
DATABASE_URL=jdbc:postgresql://localhost:5432/novora_crm
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
# Production (Neon / Render): paste the full connection string; user and password are read from it.
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Frontend address(es), comma-separated. Production: your Vercel URL, no trailing slash.
CORS_ORIGIN=http://localhost:5173

# Required, at least 32 characters. Production: two different values from `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Gmail (forgot password, invites, emailing quotes, task due reminders). Leave empty to print emails in the API log instead.
# Use an App Password, not your normal password: Google Account > Security > 2-Step Verification > App passwords.
GMAIL_USERNAME=you@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
MAIL_FROM_NAME=Novora CRM

# Task due-date reminder emails (every 15 min UTC by default). Uses Gmail vars above; no extra secrets.
# Sends once per open task when due within ACTIVITY_REMINDER_LEAD_HOURS (or overdue). Reopening a completed
# task clears the sent flag so it can remind again. Leave Gmail empty in local/dev to log instead of send.
# ACTIVITY_REMINDER_CRON=0 */15 * * * *
# ACTIVITY_REMINDER_LEAD_HOURS=24

# Where links in emails point (the frontend). Production: your Vercel URL.
APP_URL=http://localhost:5173

# Novora HRMS connection (Settings > HRMS). Leave HRMS_SYNC_ENABLED=false until both servers are configured.
# HRMS_INTEGRATION_SECRET must equal CRM_INTEGRATION_SECRET on the HRMS server; generate it once with
# `openssl rand -base64 48`.
HRMS_SYNC_ENABLED=false
HRMS_BASE_URL=http://localhost:8081
HRMS_INTEGRATION_SECRET=

# Local development only: creates admin@novora.local / password123 on startup. Never set this in production.
SEED_DEMO_ADMIN=true
